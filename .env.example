# Required by the Python backend (app/) -- this is the only service
# backend.Dockerfile / railway.json build and deploy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# NOT used by this backend: DATABASE_URL. That's consumed by web/ (the
# Next.js site's Postgres-backed result storage, see web/.env.local.example)
# -- a separate deployment with its own build. The Python API in app/ is
# stateless and has no database dependency; don't set DATABASE_URL for
# *this* Railway service, it does nothing here.
